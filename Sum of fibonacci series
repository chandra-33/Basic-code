import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter n: ");
        int n = sc.nextInt();
        sc.close();

        int t1 = 0, t2 = 1, t3, sum = t1 + t2;

        if (n == 0) {
            sum = 0;
        } else if (n == 1) {
            sum = 1;
        } else {
            for (int i = 2; i <= n; i++) {
                t3 = t1 + t2;
                sum += t3;
                t1 = t2;
                t2 = t3;
            }
        }

        System.out.println("Sum of first " + n + " Fibonacci numbers: " + sum);
    }
}
